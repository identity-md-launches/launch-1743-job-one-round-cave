{
  "type": "object",
  "required": ["task", "status", "checks"],
  "additionalProperties": false,
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["pass", "fail", "blocked"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "seconds": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
